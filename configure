#!/bin/sh
# CUDA detection for rcupp.
#
# Runs at the PACKAGE ROOT at install time and renders src/Makevars from
# src/Makevars.in (the gputools model). It must NEVER fail when CUDA is absent:
# without a toolkit we still build a CPU reference shim so the package remains
# installable and testable on any machine (and so R CMD check stays clean).
#
# Detection order:
#   --with-cuda-home=... > $CUDA_HOME > $CUDA_PATH > nvcc on PATH > /usr/local/cuda
# `source cuda-env.sh` puts nvcc on PATH, which is the usual way to "load nvcc".

if [ ! -f src/Makevars.in ]; then
  echo "configure: ERROR - src/Makevars.in is missing" >&2
  exit 1
fi

for a in "$@"; do
  case "$a" in
    --with-cuda-home=*) CUDA_HOME="${a#--with-cuda-home=}" ;;
  esac
done

if [ -z "${CUDA_HOME:-}" ] && [ -n "${CUDA_PATH:-}" ]; then
  CUDA_HOME="$CUDA_PATH"
fi

if [ -z "${CUDA_HOME:-}" ] && command -v nvcc >/dev/null 2>&1; then
  CUDA_HOME="$(cd "$(dirname "$(command -v nvcc)")/.." && pwd)"
fi

if [ -z "${CUDA_HOME:-}" ] && [ -d /usr/local/cuda ]; then
  CUDA_HOME=/usr/local/cuda
fi

CUDA_LIBDIR=""
if [ -n "${CUDA_HOME:-}" ]; then
  if   [ -d "$CUDA_HOME/lib64" ]; then CUDA_LIBDIR="$CUDA_HOME/lib64"
  elif [ -d "$CUDA_HOME/lib"   ]; then CUDA_LIBDIR="$CUDA_HOME/lib"
  fi
fi

HAVE_CUDA=0
if [ -n "${CUDA_HOME:-}" ] && [ -x "$CUDA_HOME/bin/nvcc" ] \
   && [ -f "$CUDA_HOME/include/cuda_runtime.h" ] \
   && [ -n "$CUDA_LIBDIR" ] \
   && ls "$CUDA_LIBDIR"/libcudart.so* >/dev/null 2>&1; then
  HAVE_CUDA=1
fi

# GPU architecture; override for other cards, e.g. RCUPP_CUDA_ARCH=90.
CUDA_ARCH="${RCUPP_CUDA_ARCH:-89}"

if [ "$HAVE_CUDA" -eq 1 ]; then
  echo "configure: CUDA Toolkit at $CUDA_HOME -> building GPU backend (sm_$CUDA_ARCH)"
  V_CUDA_HOME="$CUDA_HOME"
  V_NVCC="$CUDA_HOME/bin/nvcc"
  V_CPPFLAGS="-I$CUDA_HOME/include -DHAVE_CUDA"
  V_LIBS="-L$CUDA_LIBDIR -Wl,-rpath,$CUDA_LIBDIR -lcudart -lcublas"
  V_NVCCFLAGS="-O2 -Xcompiler -fPIC -Xcompiler -std=gnu++17 -gencode arch=compute_$CUDA_ARCH,code=sm_$CUDA_ARCH -I$CUDA_HOME/include -DHAVE_CUDA"
  V_EXTRA="gpu_ops.o lasso_fista_cuda.o rcupp_api_cuda.o rcupp_session_cuda.o rcupp_ctx_cuda.o"
else
  echo "configure: WARNING - no usable CUDA Toolkit; building CPU reference shim (GPU disabled)." >&2
  echo "configure: after installing the toolkit: source cuda-env.sh && make install-gpu" >&2
  V_CUDA_HOME=""
  V_NVCC=""
  V_CPPFLAGS=""
  V_LIBS=""
  V_NVCCFLAGS=""
  V_EXTRA="cpu_stub.o rcupp_api_cpu.o rcupp_session_cpu.o rcupp_ctx_cpu.o"
fi

sed -e "s|@CUDA_HOME@|$V_CUDA_HOME|g" \
    -e "s|@CUDA_CPPFLAGS@|$V_CPPFLAGS|g" \
    -e "s|@CUDA_LIBS@|$V_LIBS|g" \
    -e "s|@NVCC@|$V_NVCC|g" \
    -e "s|@NVCCFLAGS@|$V_NVCCFLAGS|g" \
    -e "s|@EXTRA_OBJECTS@|$V_EXTRA|g" \
    src/Makevars.in > src/Makevars

exit 0
